{
    "name": "phpbrew/phpbrew",
    "description": "PHPBrew API library",
    "license": "MIT",
    "authors": [
        {
            "name": "c9s",
            "email": "cornelius.howl@gmail.com"
        },
        {
            "name": "Márcio Almada",
            "email": "marcio3w@gmail.com",
            "homepage": "https://github.com/marcioAlmada/"
        }
    ],
    "config" : {
        "platform": {
            "php": "8.1"
        }
    },
    "bin": [
        "bin/phpbrew"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "corneltek/pearx": "^1.3.5",
        "corneltek/curlkit": "^1.0.11",
        "ext-simplexml": "*",
        "symfony/console": "^6.4",
        "symfony/yaml": "^6.4",
        "jean85/pretty-package-versions": "^2.0"
    },
    "require-dev": {
        "php-vcr/php-vcr": "^1.5.4",
        "phpunit/phpunit": "^8.5.33",
        "corneltek/getoptionkit": "^2.7"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "PhpBrew\\": "src/PhpBrew/"
        }
    }
}
